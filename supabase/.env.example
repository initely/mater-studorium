# Скопируй в supabase/.env (файл в .gitignore) и подставь свои значения.
# Читается при `supabase start` (env(...) в config.toml). README, «Привязка Google».
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<Client ID веб-клиента из Google Cloud Console>
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<Client secret того же клиента>
