{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mater Studorium deck",
  "description": "Колода: источник истины контента (ТЗ §7.1, ADR-7, ADR-18). Структура проверяется этой схемой, перекрёстные ссылки и правила форматов — семантикой в lib/features/catalog/domain/deck_validator.dart. Любое изменение схемы = +1 к schema_version (ADR-18).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "lang",
    "topic",
    "title",
    "description",
    "sources",
    "items"
  ],
  "properties": {
    "schema_version": {
      "description": "Версия формата колоды. Текущая — 1.",
      "const": 1
    },
    "id": {
      "description": "Стабильный ID колоды; используется в путях Storage.",
      "$ref": "#/$defs/DeckId"
    },
    "version": {
      "description": "Версия содержимого; растёт при каждом import_deck.",
      "type": "integer",
      "minimum": 1
    },
    "lang": {
      "description": "Язык контента, ISO 639-1.",
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "topic": { "$ref": "#/$defs/DeckId" },
    "title": { "$ref": "#/$defs/Text" },
    "description": { "$ref": "#/$defs/Text" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Source" }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Item" }
    }
  },
  "$defs": {
    "Text": {
      "description": "Непустая строка, не из одних пробелов.",
      "type": "string",
      "pattern": "\\S"
    },
    "DeckId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "Id": {
      "description": "ID источника, знания или вопроса. Стабилен между версиями колоды.",
      "type": "string",
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "LocalId": {
      "description": "ID внутри вопроса: опция, пропуск, шаг, пункт рубрики.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 32
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "license"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "title": { "$ref": "#/$defs/Text" },
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "license": {
          "description": "Лицензия источника (например, \"CC BY-SA 4.0\"). Обязательна (R8).",
          "$ref": "#/$defs/Text"
        }
      }
    },
    "Item": {
      "description": "Знание — единица планирования FSRS (ТЗ §4.1).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "fact",
        "explanation_short",
        "explanation_long",
        "refs",
        "review",
        "questions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "title": { "$ref": "#/$defs/Text" },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/Id" }
        },
        "fact": { "$ref": "#/$defs/Text" },
        "explanation_short": {
          "description": "«Коротко»: 2–3 предложения.",
          "$ref": "#/$defs/Text"
        },
        "explanation_long": {
          "description": "«Подробнее»: markdown до ~300 слов.",
          "$ref": "#/$defs/Text"
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Ref" }
        },
        "review": { "$ref": "#/$defs/Review" },
        "questions": {
          "description": "1–4 варианта вопроса (ТЗ §4.1).",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/Question" }
        }
      }
    },
    "Ref": {
      "description": "Привязка факта к источнику. URL берётся из sources по source_id.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "quote"],
      "properties": {
        "source_id": { "$ref": "#/$defs/Id" },
        "quote": {
          "description": "Дословная цитата со страницы источника.",
          "$ref": "#/$defs/Text"
        },
        "quote_unverifiable": {
          "description": "true — страница недоступна скрипту (paywall и т.п.), check_links проверяет только код 200.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "Review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "description": "draft — не вычитано; needs_fix — верификация или вычитка нашла проблемы; approved — вычитано человеком.",
          "enum": ["draft", "needs_fix", "approved"]
        },
        "by": { "type": "string" },
        "notes": { "type": "string" }
      },
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": {
        "required": ["by"],
        "properties": { "by": { "$ref": "#/$defs/Text" } }
      }
    },
    "Question": {
      "description": "Вариант вопроса. payload — дискриминированное объединение по type.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "prompt", "payload"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": {
          "enum": ["mcq", "flip", "open", "cloze", "order", "find_error"]
        },
        "prompt": {
          "description": "Текст вопроса. Для cloze содержит плейсхолдеры {{id}}.",
          "$ref": "#/$defs/Text"
        },
        "explanation_short": {
          "description": "Переопределяет explanation_short знания для этого вопроса (ТЗ §4.4).",
          "$ref": "#/$defs/Text"
        },
        "payload": { "type": "object" }
      },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "mcq" },
            "payload": { "$ref": "#/$defs/McqPayload" }
          }
        },
        {
          "properties": {
            "type": { "const": "flip" },
            "payload": { "$ref": "#/$defs/FlipPayload" }
          }
        },
        {
          "properties": {
            "type": { "const": "open" },
            "payload": { "$ref": "#/$defs/OpenPayload" }
          }
        },
        {
          "properties": {
            "type": { "const": "cloze" },
            "payload": { "$ref": "#/$defs/ClozePayload" }
          }
        },
        {
          "properties": {
            "type": { "const": "order" },
            "payload": { "$ref": "#/$defs/OrderPayload" }
          }
        },
        {
          "properties": {
            "type": { "const": "find_error" },
            "payload": { "$ref": "#/$defs/FindErrorPayload" }
          }
        }
      ]
    },
    "McqPayload": {
      "description": "Выбор из вариантов. Клиент перемешивает опции; проверка — совпадение множеств.",
      "type": "object",
      "additionalProperties": false,
      "required": ["options", "correct", "multiple"],
      "properties": {
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": { "$ref": "#/$defs/LocalId" },
              "text": { "$ref": "#/$defs/Text" }
            }
          }
        },
        "correct": {
          "description": "ID верных опций.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/LocalId" }
        },
        "multiple": {
          "description": "false — ровно один верный вариант (радиокнопки).",
          "type": "boolean"
        }
      }
    },
    "FlipPayload": {
      "description": "Карточка: prompt — лицевая сторона, back — оборот; оценка — самооценка.",
      "type": "object",
      "additionalProperties": false,
      "required": ["back"],
      "properties": {
        "back": { "$ref": "#/$defs/Text" }
      }
    },
    "OpenPayload": {
      "description": "Открытый ответ, оценивается grade-open-answer по рубрике (ТЗ §4.2, §5.2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_answer", "rubric"],
      "properties": {
        "reference_answer": {
          "description": "Эталон, 1–3 предложения.",
          "$ref": "#/$defs/Text"
        },
        "rubric": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/RubricPoint" },
          "contains": {
            "required": ["required"],
            "properties": { "required": { "const": true } }
          }
        }
      }
    },
    "RubricPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "weight", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/LocalId" },
        "text": { "$ref": "#/$defs/Text" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 3 },
        "required": {
          "description": "miss по этому пункту ограничивает вердикт значением partial.",
          "type": "boolean"
        }
      }
    },
    "ClozePayload": {
      "description": "Пропуски {{id}} в prompt. Грейдер: нормализация, accepted, опечатка ≤ 1 при длине ≥ 6, числа как числа (ТЗ §4.3).",
      "type": "object",
      "additionalProperties": false,
      "required": ["blanks"],
      "properties": {
        "blanks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "accepted"],
            "properties": {
              "id": { "$ref": "#/$defs/LocalId" },
              "accepted": {
                "description": "Допустимые ответы; первый показывается как правильный.",
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/Text" }
              }
            }
          }
        }
      }
    },
    "OrderPayload": {
      "description": "Шаги в эталонном порядке; клиент перемешивает.",
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 3,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": { "$ref": "#/$defs/LocalId" },
              "text": { "$ref": "#/$defs/Text" }
            }
          }
        }
      }
    },
    "FindErrorPayload": {
      "description": "Найти ошибочные строки. Номера строк 1-based.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "lines", "error_lines", "line_explanations"],
      "properties": {
        "mode": { "enum": ["code", "text"] },
        "language": {
          "description": "Язык подсветки для mode=code (например, nginx, python).",
          "$ref": "#/$defs/Text"
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" }
        },
        "error_lines": {
          "description": "Множество ошибочных строк, 1–2 номера.",
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "line_explanations": {
          "description": "Пояснения по номеру строки; обязательно для каждой строки из error_lines.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[1-9][0-9]*$" },
          "additionalProperties": { "$ref": "#/$defs/Text" }
        }
      }
    }
  }
}
