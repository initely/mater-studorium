      ]
    },
    {
      "name": "items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"items\" (\"id\" TEXT NOT NULL, \"deck_id\" TEXT NOT NULL REFERENCES decks (id), \"title\" TEXT NOT NULL, \"fact\" TEXT NOT NULL, \"explanation_short\" TEXT NOT NULL, \"explanation_long\" TEXT NOT NULL, \"refs_json\" TEXT NOT NULL, \"retired\" INTEGER NOT NULL DEFAULT 0 CHECK (\"retired\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "questions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"questions\" (\"id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL REFERENCES items (id), \"type\" TEXT NOT NULL, \"prompt\" TEXT NOT NULL, \"payload_json\" TEXT NOT NULL, \"explanation_short\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
