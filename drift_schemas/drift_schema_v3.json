      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"decks\" (\"id\" TEXT NOT NULL, \"version\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"topic\" TEXT NOT NULL, \"lang\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"downloaded_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
